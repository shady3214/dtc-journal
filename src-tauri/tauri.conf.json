{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Forex Journal",
  "version": "0.1.6",
  "identifier": "com.dtc.journal",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Forex Journal",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "allowDowngrades": false
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["dtcjournal"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzN0FDRjI4QjM1MTVBQjYKUldTMldsR3pLTTk2cy93TWVNNFFSSEdZektrUXEwdEQ4MjZLR00zbU93NVhlWmp6VERuWVZxUDMK",
      "endpoints": [
        "https://github.com/shady3214/dtc-journal/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

